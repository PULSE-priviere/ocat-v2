# ── Supabase (Settings > API) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # serveur uniquement, jamais NEXT_PUBLIC_

# ── App ──
APP_URL=https://votre-app.vercel.app
NEXT_PUBLIC_ORG_NAME=Mon organisation
NEXT_PUBLIC_APP_NAME=Diagnostic organisationnel
NEXT_PUBLIC_LOGO_URL=/brand/logo.svg  # fichier public/brand/logo.svg versionné
IP_HASH_SALT=                         # chaîne aléatoire longue

# ── Anti-robot Cloudflare Turnstile (laisser vide en local pour le désactiver) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── E-mails : MAIL_PROVIDER = smtp | resend | airtable | console ──
MAIL_PROVIDER=console
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_OUTBOX_TABLE=Outbox
RESEND_API_KEY=
# Envoi direct par SMTP (par exemple Gmail avec un mot de passe d'application) : MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=                        # mot de passe d'application (les espaces sont acceptés)
MAIL_REPLY_TO=                    # adresse de réponse (une vraie boîte), recommandée avec resend
MAIL_FROM=diagnostic@exemple.org

# ── Suivi-évaluation : export des scores vers Airtable (même jeton et même base que l'e-mail) ──
# Les trois tables (Organisations, Diagnostics, Accompagnement) se règlent dans Administration > Airtable
AIRTABLE_SCORES_AUTO=true            # envoi automatique vers Airtable (false pour désactiver) ; réglable aussi dans Administration > Airtable
# AIRTABLE_API_URL=                   # tests uniquement : adresse d'un faux serveur Airtable
