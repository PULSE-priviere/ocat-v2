# ── Supabase (Settings > API) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # serveur uniquement, jamais NEXT_PUBLIC_

# ── App ──
APP_URL=https://votre-app.vercel.app
NEXT_PUBLIC_ORG_NAME=Mon organisation
NEXT_PUBLIC_APP_NAME=Diagnostic organisationnel
NEXT_PUBLIC_LOGO_URL=/brand/logo.svg  # fichier public/brand/logo.svg versionné
IP_HASH_SALT=                         # chaîne aléatoire longue

# ── Anti-robot Cloudflare Turnstile (laisser vide en local pour le désactiver) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── E-mails : MAIL_PROVIDER = airtable | resend | console ──
MAIL_PROVIDER=console
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_OUTBOX_TABLE=Outbox
RESEND_API_KEY=
MAIL_FROM=diagnostic@exemple.org
